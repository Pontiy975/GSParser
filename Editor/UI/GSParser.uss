/* ── Root ──────────────────────────────────────────────────────────────── */
#gs-root {
    flex-grow: 1;
    background-color: #1e1e1e;
    color: #d4d4d4;
}

/* ── Tab bar ───────────────────────────────────────────────────────────── */
#tab-bar {
    flex-direction: row;
    background-color: #2a2a2a;
    border-bottom-width: 1px;
    border-bottom-color: #111;
    height: 30px;
    flex-shrink: 0;
}

.tab-btn {
    flex-grow: 1;
    height: 30px;
    margin: 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 0;
    background-color: #2a2a2a;
    color: #777;
    font-size: 11px;
    -unity-font-style: normal;
    border-right-width: 1px;
    border-right-color: #1a1a1a;
    cursor: link;
    transition: background-color 0.1s;
}

.tab-btn:hover {
    background-color: #333;
    color: #bbb;
}

.tab-btn--active {
    background-color: #1e1e1e;
    color: #e8e8e8;
    border-bottom-width: 2px;
    border-bottom-color: #4c9be8;
    -unity-font-style: bold;
}

/* ── Section titles ────────────────────────────────────────────────────── */
.section-title {
    font-size: 10px;
    color: #555;
    -unity-font-style: bold;
    margin-bottom: 5px;
    margin-top: 10px;
}

/* ── Text fields ───────────────────────────────────────────────────────── */
TextField {
    margin-bottom: 3px;
}

TextField > Label {
    min-width: 110px;
    color: #999;
    font-size: 11px;
}

/* ── Dropdown ──────────────────────────────────────────────────────────── */
DropdownField > Label {
    min-width: 0;
    width: 0;
}

/* ── Buttons ───────────────────────────────────────────────────────────── */
.btn-primary {
    background-color: #2a5a8a;
    border-color: #1a4a7a;
    border-width: 1px;
    border-radius: 3px;
    color: #e8e8e8;
    height: 26px;
    -unity-font-style: bold;
    font-size: 11px;
}

.btn-primary:hover {
    background-color: #3568a0;
}

.btn-primary:disabled {
    background-color: #2a2a2a;
    border-color: #333;
    color: #666;
}

.btn-secondary {
    background-color: #2e2e2e;
    border-color: #3e3e3e;
    border-width: 1px;
    border-radius: 3px;
    color: #aaa;
    height: 26px;
    font-size: 11px;
}

.btn-secondary:hover {
    background-color: #383838;
    color: #ddd;
}

.btn-danger:hover {
    color: #e07070;
}

.btn-icon {
    width: 22px;
    height: 22px;
    padding: 0;
    margin: 0;
    border-radius: 3px;
    background-color: #2e2e2e;
    border-color: #3e3e3e;
    border-width: 1px;
    color: #aaa;
    font-size: 13px;
}

.btn-icon:hover {
    background-color: #3a3a3a;
}

/* ── Status ────────────────────────────────────────────────────────────── */
#conn-status {
    font-size: 11px;
    margin-top: 12px;
    padding: 5px 8px;
    border-radius: 3px;
    background-color: #252525;
    border-left-width: 3px;
    border-left-color: #555;
    color: #777;
}

.status--connected {
    color: #6abf69;
    border-left-color: #6abf69;
}

.status--idle {
    color: #777;
    border-left-color: #555;
}

.status--loading {
    color: #d4a84b;
    border-left-color: #d4a84b;
}

.status--error {
    color: #c75050;
    border-left-color: #c75050;
}

/* ── Warning ───────────────────────────────────────────────────────────── */
#conn-warning {
    background-color: #2e2010;
    border-color: #a05020;
    border-width: 1px;
    border-radius: 3px;
    padding: 5px 8px;
    color: #c07840;
    font-size: 11px;
    white-space: normal;
    margin-top: 6px;
}

.warning-box {
    background-color: #2e2010;
    border-color: #a05020;
    border-width: 1px;
    border-radius: 3px;
    padding: 5px 8px;
    color: #c07840;
    font-size: 11px;
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 6px;
}

/* ── Viewer toolbar ────────────────────────────────────────────────────── */
#viewer-toolbar {
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
    background-color: #252525;
    border-bottom-width: 1px;
    border-bottom-color: #111;
    height: 30px;
    flex-shrink: 0;
}

#viewer-info {
    flex-grow: 1;
    color: #666;
    font-size: 11px;
}

#viewer-refresh {
    height: 22px;
    width: 64px;
    font-size: 11px;
    background-color: #2e2e2e;
    border-color: #3e3e3e;
    border-width: 1px;
    border-radius: 3px;
    color: #aaa;
}

#viewer-refresh:hover {
    background-color: #383838;
    color: #ddd;
}

/* ── MultiColumnListView ───────────────────────────────────────────────── */
#viewer-table-container {
    flex-grow: 1;
    overflow: hidden;
}

MultiColumnListView {
    flex-grow: 1;
    background-color: #1e1e1e;
    border-width: 0;
    overflow: hidden;
}

/* Header */
.unity-multi-column-view__header {
    background-color: #252525;
    border-bottom-width: 1px;
    border-bottom-color: #111;
    min-height: 26px;
    max-height: 26px;
}

.unity-multi-column-header__column {
    border-right-width: 1px;
    border-right-color: #1a1a1a;
    padding: 0 6px;
    background-color: #252525;
}

.unity-multi-column-header__column:hover {
    background-color: #2e2e2e;
}

.unity-multi-column-header__column > Label {
    color: #999;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* Sort arrow */
.unity-multi-column-header__column-sort-indicator {
    color: #4c9be8;
}

/* Rows */
.unity-list-view__item {
    border-bottom-width: 1px;
    border-bottom-color: #232323;
    padding: 0;
}

.unity-list-view__item--odd {
    background-color: #1e1e1e;
}

.unity-list-view__item--even {
    background-color: #212121;
}

.unity-list-view__item:hover {
    background-color: #263040;
}

.unity-list-view__item--selected {
    background-color: #1a3a5a;
}

/* Cell labels */
MultiColumnListView Label {
    font-size: 11px;
    color: #c8c8c8;
    padding: 0 6px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Resize handle */
.unity-multi-column-header__column-resizer {
    background-color: #333;
    width: 2px;
}

.unity-multi-column-header__column-resizer:hover {
    background-color: #4c9be8;
}

/* Scrollbar */
.unity-scroller--vertical {
    background-color: #1e1e1e;
    width: 10px;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: #3e3e3e;
    border-radius: 4px;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: #4e4e4e;
}

/* ── Log ───────────────────────────────────────────────────────────────── */
#log-scroll {
    flex-grow: 1;
    background-color: #1a1a1a;
}

#log-content {
    color: #999;
    font-size: 11px;
    white-space: normal;
    padding: 8px;
}

/* ── Placeholder ───────────────────────────────────────────────────────── */
.placeholder-label {
    color: #444;
    font-size: 12px;
    -unity-text-align: upper-center;
    margin-top: 40px;
}

/* ── Generic row layout (Parser tab: preset selector, path+browse) ───────── */
.row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.row > TextField,
.row > DropdownField {
    flex-grow: 1;
    margin-right: 4px;
    margin-bottom: 0;
}

.row > .btn-icon {
    flex-shrink: 0;
}

/* ── Field mappings (Parser tab) ───────────────────────────────────────── */
.mappings-scroll {
    flex-grow: 1;
    min-height: 120px;
    max-height: 280px;
    margin-bottom: 6px;
    background-color: #1a1a1a;
    border-width: 1px;
    border-color: #2a2a2a;
    border-radius: 3px;
    padding: 4px 6px;
}

.mapping-row {
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: #2a2a2a;
    margin-bottom: 2px;
}

.mapping-row-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.mapping-field-name {
    font-size: 11px;
    color: #c8c8c8;
    -unity-font-style: bold;
}

.mapping-field-type {
    font-size: 10px;
    color: #666;
    margin-left: 6px;
}